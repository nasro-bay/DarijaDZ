# One-time-rebuild backup dirs (data/backup_<reason>/ — see CLAUDE.md's
# "rebuilding processed output" convention) — always local-only, never
# versioned, regardless of which rebuild produced them.
**/data/backup_*/

# Internal planning/context docs (not for the public repo)
Project_context.md
CLAUDE.md
AGENTS.md
**/PLAN.md
# GPU optimization playbook -- derived from a separate, non-Darija lab
# (deep learning/labs/training neural networks/GPU_exp/), copied in here only
# as a working reference for this repo's own GPU runs. Same local-only
# treatment as CLAUDE.md above -- not Darija project content.
GPU_optimization.md
N-gram/plan.md
Embeddings/intrinsic_eval/plan.md
Embeddings/intrinsic_eval/guide.md
Embeddings/word2vec/plan.md
Embeddings/word2vec/guide.md
local_models/plan.md
local_models/guide.md
Dialect_Identification/plan.md
Dialect_Identification/guide.md
Mountada_djelfa_scrap/djelfa_scrap.md

# Sample/placeholder data — a single combined dataset will be added
# explicitly later instead of these
Data/*.jsonl
Data/*.json

# Notebook checkpoints
.ipynb_checkpoints/

#CSVs
Data/*.csv

# Tokenizer training corpus/held-out set and trained model artifacts --
# large and fully reproducible via Tokenization/scripts/*.py, same
# "generated data, not versioned" treatment as every other data/ dir above.
Tokenization/data/*
Tokenization/models/*
Tokenization/models_bigcorpus/*
Tokenization/models_backup_*/
!Tokenization/data/.gitkeep
!Tokenization/models/.gitkeep

DarijaDZ/*
Kaggle_DarijaDz/*
Kaggle.md

# Same treatment -- HF dataset release staging folder for the dialect-ID
# labels, generated from Dialect_Identification/data/labeled_10k.jsonl,
# pushed to HF directly, not versioned here.
DarijaDZ_DialectID/*

# Same treatment -- HF model-repo staging folder for the char n-gram +
# SVM-RBF dialect classifier (skops-serialized), generated from
# Dialect_Identification/models/best_model/*.pkl via
# Dialect_Identification/scripts/best_model/train_and_save.py, pushed to
# HF directly, not versioned here.
DarijaDZ_DialectID_Classifier/*

# HF model-repo staging folder (same treatment as DarijaDZ/Kaggle_DarijaDz
# above) -- large trained tokenizer artifacts (.model/.vocab/tokenizer.json
# etc.), reproducible via Tokenization/scripts/build_hf_repo.py and
# published via `hf upload`, not git.
DarijaDz_Tokenizers/*

# Benchmark datasets (Benchmarks/<name>/) -- downloaded/exported dataset
# files ignored, same "data ignored, scripts/docs tracked" treatment as
# Youtube_scrap/Mountada_djelfa_scrap above; each benchmark's own
# exploration scripts and write-up stay tracked. Also covers the HF
# `datasets` library's on-disk cache if pointed inside a benchmark folder
# instead of the default ~/.cache/huggingface.
# Exception: each benchmark's own <name>_report.json (the exploration
# script's computed summary -- small, worth versioning, not raw
# third-party data) stays tracked, unlike everything else under data/.
Benchmarks/*/data/*
!Benchmarks/*/data/.gitkeep
!Benchmarks/*/data/*_report.json
Benchmarks/*/report.md

# NArabizi-main/ was downloaded as a full clone of the paper's own repo,
# which bundles its reproduction code (experiments/) alongside the data --
# third-party code, not this project's own scripts, so it gets the same
# "not tracked here" treatment as the data itself rather than being vendored.
Benchmarks/NArabizi-main/experiments/*

# N-gram LM: augmented corpus, tokenized train/dev/test splits, and
# trained ARPA/binary models -- large and fully reproducible via
# N-gram/scripts/*.py, same "generated data, not versioned" treatment as
# Tokenization/ above. The small report/eval JSONs (build + eval summary
# stats) stay tracked, same exception as Benchmarks/ above.
N-gram/data/*
N-gram/models/*
!N-gram/data/.gitkeep
!N-gram/models/.gitkeep
!N-gram/data/*_report.json
!N-gram/data/eval_*.json

# CBOW+attention word embedding model: prepared training cache and
# checkpoints -- large and reproducible via
# Embeddings/word2vec_attention/scripts/*.py, same treatment as N-gram/
# above. plan.md/guide.md weren't covered by the general **/PLAN.md-style
# rules above after this folder was renamed from word2vec/ to
# word2vec_attention/ -- added explicitly here (the Embeddings/word2vec/
# plan.md/guide.md lines further up now correctly cover the *new*
# word2vec/ folder instead, which holds the classic CBOW/Skip-gram
# baselines -- see Embeddings/word2vec/plan.md).
Embeddings/word2vec_attention/data/*
Embeddings/word2vec_attention/models/*
Embeddings/word2vec_attention/data_bigcorpus/*
Embeddings/word2vec_attention/models_bigcorpus/*
Embeddings/word2vec_attention/data_backup_*/
Embeddings/word2vec_attention/models_backup_*/
Embeddings/word2vec_attention/models_dim64/*
!Embeddings/word2vec_attention/data/.gitkeep
!Embeddings/word2vec_attention/models/.gitkeep
!Embeddings/word2vec_attention/models_dim64/.gitkeep
Embeddings/word2vec_attention/plan.md
Embeddings/word2vec_attention/guide.md

# Classic CBOW + Skip-gram baselines (no attention) -- share
# word2vec_attention/data/'s prepared cache (read directly, not copied),
# so only checkpoints need ignoring here, no data/ dir per subfolder.
# models_dim64/ (the 64-d variant, its own folder via WORD2VEC_MODELS_DIR --
# see each guide.md) gets the same treatment as models/.
Embeddings/word2vec/cbow/models/*
Embeddings/word2vec/skip-gram/models/*
Embeddings/word2vec/cbow/models_bigcorpus/*
Embeddings/word2vec/skip-gram/models_bigcorpus/*
Embeddings/word2vec/cbow/models_backup_*/
Embeddings/word2vec/skip-gram/models_backup_*/
Embeddings/word2vec/cbow/models_dim64/*
Embeddings/word2vec/skip-gram/models_dim64/*
!Embeddings/word2vec/cbow/models/.gitkeep
!Embeddings/word2vec/skip-gram/models/.gitkeep
!Embeddings/word2vec/cbow/models_dim64/.gitkeep
!Embeddings/word2vec/skip-gram/models_dim64/.gitkeep

# GloVe (Embeddings/glove): the selected corpus, tokenized arrays, co-occurrence
# shards and trained vectors are large and fully reproducible via
# Embeddings/glove/scripts/*.py -- same "generated data, not versioned"
# treatment as the other embedding folders. plan.md/guide.md are internal docs.
# glove_run*.log are training-run console logs, same treatment as data/.
Embeddings/glove/data/*
Embeddings/glove/models/*
Embeddings/glove/*.log
!Embeddings/glove/data/.gitkeep
!Embeddings/glove/models/.gitkeep
Embeddings/glove/plan.md
Embeddings/glove/guide.md

# ELMo (Embeddings/elmo): memmapped id streams, vocab/char tables and biLM
# checkpoints are large and reproducible via Embeddings/elmo/scripts/*.py --
# same treatment as the other embedding folders. plan.md/guide.md are internal docs.
# tests/ was pushed once already -- untracked (git rm --cached) and ignored
# per explicit instruction, same "ignore models/data/tests" treatment applied
# repo-wide across Embeddings/ below.
Embeddings/elmo/data/*
Embeddings/elmo/models/*
Embeddings/elmo/tests/*
!Embeddings/elmo/data/.gitkeep
!Embeddings/elmo/models/.gitkeep
Embeddings/elmo/plan.md
Embeddings/elmo/guide.md

# Embeddings/intrinsic_eval/data: the curated word-similarity/analogy gold
# sets (analogy_pairs.jsonl, word_similarity.jsonl) -- hand-authored, NOT
# reproducible from a script like every other Embeddings/*/data/ above.
# Untracked (git rm --cached) and ignored per explicit "ignore data" for
# this directory; unlike the rest, losing the only copy here would lose
# real hand-curated work, so keep a backup outside git if these change.
Embeddings/intrinsic_eval/data/*
!Embeddings/intrinsic_eval/data/.gitkeep

# Dialect/language-ID sampling + Qwen3.5-4B-labeled dataset -- large,
# reproducible via Dialect_Identification/scripts/build_dataset.py +
# label_dataset.py, same treatment as N-gram/ and Embeddings/word2vec/
# above. review_flags.jsonl stays tracked -- small, historical review
# notes from the prompt-tuning phase, same "small report stays" exception
# as N-gram's/Benchmarks' report files.
Dialect_Identification/data/*
!Dialect_Identification/data/.gitkeep
!Dialect_Identification/data/review_flags.jsonl

# Word-cluster classifier's model artifact (scripts/word_cluster/build_clusters.py)
# -- reproducible from data/train.jsonl + the trained CBOWAttention checkpoint,
# same treatment as the embedding model checkpoints above.
Dialect_Identification/models/*
!Dialect_Identification/models/.gitkeep

# NArabizi sentiment-analysis work (separate from Benchmarks/NArabizi-main,
# which is just data exploration): joined train/dev/test JSONL, reproducible
# via NArabizi_sent/scripts/build_dataset.py, same treatment as above.
NArabizi_sent/data/*
!NArabizi_sent/data/.gitkeep
NArabizi_sent/

# LM_DiD -- decoder-only word-level LM. data/ (vocab.json, tokens.bin,
# tokens_meta.json) reproducible via scripts/build_vocab.py +
# build_training_data.py; models/ are training checkpoints. plan.md/
# guide.md are internal docs, same treatment as every other subproject.
LM_DiD/data/*
!LM_DiD/data/.gitkeep
LM_DiD/models/*
!LM_DiD/models/.gitkeep
LM_DiD/plan.md
LM_DiD/guide.md
DarijaDZ_scalinglaws/plan.md

# DarijaDZ_scalinglaws: token caches, sweep result JSON/plots (data/) and the course lab
# handout (md/pdf) -- pushed by mistake once, removed from the remote; data/ is reproducible
# via scripts/build_data.py + the notebooks, and the handout isn't this project's own content.
DarijaDZ_scalinglaws/data/*
!DarijaDZ_scalinglaws/data/.gitkeep
DarijaDZ_scalinglaws/scaling_laws_lab.md
DarijaDZ_scalinglaws/scaling_laws_lab.pdf

# DarijaDZ_spaces: each Space's app.py/requirements.txt/README.md/assets stay tracked, but the
# model weights, vocab/lookup data, and test files are local-only -- weights and data are
# reproducible (DarijaDZ_WE/model.safetensors + vocab.json copied from Embeddings/glove, map2d.npz
# via build_assets.py; Arabizi_transliteration's *.jsonl/*.txt are corpus-derived word/frequency
# data, same treatment as every other subproject's data/ above), and the test files (originally
# published to the live HF Space, harmlessly) don't need to be duplicated in this repo either.
DarijaDZ_spaces/DarijaDZ_WE/model.safetensors
DarijaDZ_spaces/DarijaDZ_WE/vocab.json
DarijaDZ_spaces/DarijaDZ_WE/map2d.npz
DarijaDZ_spaces/Arabizi_transliteration/arabic_comments.jsonl
DarijaDZ_spaces/Arabizi_transliteration/arabizi_frequencies.txt
DarijaDZ_spaces/Arabizi_transliteration/unigrams.txt
DarijaDZ_spaces/Arabizi_transliteration/test_transliterate.py
DarijaDZ_spaces/Arabizi_transliteration/smoke_test.py

pytest.ini

requirements-dev.txt
